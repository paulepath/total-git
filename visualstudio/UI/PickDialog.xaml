<platformUI:DialogWindow x:Class="TotalGit.VisualStudio.UI.PickDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                        xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                        platformUI:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
                        Width="560" Height="380" MinWidth="360" MinHeight="240"
                        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="12">
    <TextBlock x:Name="Prompt" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="OnFilterChanged" PreviewKeyDown="OnFilterKeyDown"
             AutomationProperties.Name="Filter" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="NewWindowButton" Content="Open in New Visual Studio" Padding="10,3" Margin="0,0,8,0" Click="OnNewWindow" />
      <Button x:Name="OkButton" Content="Open" IsDefault="True" MinWidth="80" Padding="10,3" Margin="0,0,8,0" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" />
    </StackPanel>
    <ListBox x:Name="List" MouseDoubleClick="OnListDoubleClick" AutomationProperties.Name="Choices"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" />
              <TextBlock Text="{Binding Description}" Margin="10,0,0,0" Opacity="0.7" />
            </StackPanel>
            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</platformUI:DialogWindow>
