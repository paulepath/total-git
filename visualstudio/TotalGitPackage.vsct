      <IDSymbol name="cmdCtxOpenInTotalGit" value="0x0202" />
      <IDSymbol name="cmdCtxOpenInVsCode" value="0x0203" />
      <IDSymbol name="cmdCtxReveal" value="0x0204" />
      <IDSymbol name="cmdCtxCopyPath" value="0x0205" />
      <IDSymbol name="menuTotalGit" value="0x1000" />
