<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:t="using:TotalGit.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:views="using:TotalGit.App.Views"
             x:Class="TotalGit.App.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel">
  <!-- One repository tab: toolbar, banner, sidebar, graph/diff and details. -->
  <UserControl.Styles>
    <Style Selector="Button.recentTile">
      <Setter Property="Background" Value="{x:Static t:Palette.Panel}" />
      <Setter Property="BorderBrush" Value="{x:Static t:Palette.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.recentTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.TileHover}" />
      <Setter Property="BorderBrush" Value="{x:Static t:Palette.BorderInput}" />
    </Style>
    <Style Selector="Button.tileRemove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- The remove button shows on hover, and always on a tile whose folder has gone. -->
    <Style Selector="Button.recentTile:pointerover Button.tileRemove, Button.recentTile.missing Button.tileRemove">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.Toolbar}" Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="tool" Command="{Binding OpenRepositoryCommand}" ToolTip.Tip="Open repository (Ctrl+O)">
          <StackPanel>
            <PathIcon Data="{StaticResource FolderIcon}" />
            <TextBlock Classes="label" Text="Open" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="repository" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" />
            <TextBlock Text="{Binding RepositoryName}" FontSize="16" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
          </StackPanel>
          <PathIcon Width="10" Height="10" Margin="14,14,14,0" Foreground="{x:Static t:Palette.TextMuted}" Data="{StaticResource ChevronIcon}"
                    IsVisible="{Binding HasWorktreeName}" />
          <StackPanel IsVisible="{Binding HasWorktreeName}">
            <TextBlock Text="worktree" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Image Source="{Binding CurrentBranchIcon}" IsVisible="{Binding HasCurrentBranchIcon}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding WorktreeName}" FontSize="16" FontWeight="SemiBold" Foreground="{x:Static t:Palette.WorktreeName}" />
            </StackPanel>
          </StackPanel>
          <PathIcon Width="10" Height="10" Margin="14,14,14,0" Foreground="{x:Static t:Palette.TextMuted}" Data="{StaticResource ChevronIcon}" />
          <StackPanel>
            <TextBlock Text="branch" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding CurrentBranch}">
              <Image Source="{Binding CurrentBranchIcon}" IsVisible="{Binding HasCurrentBranchIcon}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurrentBranchDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Shrinks the buttons when there isn't room (narrow window, or zoomed in) instead of overlapping the sides. -->
        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="2" IsEnabled="{Binding HasRepository}">
          <Button Classes="tool" Command="{Binding FetchCommand}" ToolTip.Tip="Fetch all remotes">
            <StackPanel>
              <PathIcon Data="{StaticResource FetchIcon}" />
              <TextBlock Classes="label" Text="Fetch" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PullCommand}" ToolTip.Tip="Pull the current branch">
            <StackPanel>
              <PathIcon Data="{StaticResource PullIcon}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="label" Text="Pull" />
                <TextBlock Classes="count" Text="{Binding BehindText}" Margin="3,3,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PushCommand}" ToolTip.Tip="{Binding PushToolTip}">
            <StackPanel>
              <PathIcon Data="{StaticResource PushIcon}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Classes="label" Text="Push" />
                <TextBlock Classes="count" Text="{Binding AheadText}" Margin="3,3,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding UndoDiscardCommand}" IsVisible="{Binding CanUndoDiscard}" ToolTip.Tip="Undo the latest discard (backups kept for seven days, up to 20)">
            <StackPanel>
              <PathIcon Data="{StaticResource ResetIcon}" />
              <TextBlock Classes="label" Text="Undo discard" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding StashCommand}" ToolTip.Tip="Stash uncommitted changes">
            <StackPanel>
              <PathIcon Data="{StaticResource StashIcon}" />
              <TextBlock Classes="label" Text="Stash" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PopLatestStashCommand}" IsEnabled="{Binding HasStashes}" ToolTip.Tip="Restore the newest stash">
            <StackPanel>
              <PathIcon Data="{StaticResource PopIcon}" />
              <TextBlock Classes="label" Text="Pop" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{x:Static t:Palette.Separator}" Margin="8,6" />
          <Button Classes="tool" Command="{Binding CreateBranchAtHeadCommand}" ToolTip.Tip="Create a branch from HEAD">
            <StackPanel>
              <PathIcon Data="{StaticResource BranchIcon}" />
              <TextBlock Classes="label" Text="Branch" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding CreateWorktreeCommand}" ToolTip.Tip="Create a worktree with a new branch from HEAD">
            <StackPanel>
              <PathIcon Data="{StaticResource WorktreeIcon}" />
              <TextBlock Classes="label" Text="Worktree" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenInVsCodeCommand}" ToolTip.Tip="Open this worktree in VS Code">
            <StackPanel>
              <PathIcon Data="{StaticResource CodeIcon}" Foreground="{x:Static t:Palette.VsCodeBlue}" />
              <TextBlock Classes="label" Text="VS Code" />
            </StackPanel>
          </Button>
          <!-- The Total Git extension for VS Code (worktrees in VS Code), bundled with each release. -->
          <Button Classes="tool" MinWidth="0" Padding="2,4" Margin="-6,0,0,0" IsVisible="{Binding OffersVsCodeExtension}"
                  ToolTip.Tip="The Total Git extension for VS Code">
            <PathIcon Data="{StaticResource ChevronIcon}" Width="10" Height="10" Foreground="{x:Static t:Palette.TextSecondary}">
              <PathIcon.RenderTransform>
                <RotateTransform Angle="90" />
              </PathIcon.RenderTransform>
            </PathIcon>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnVsCodeMenuOpening">
                <MenuItem Header="Open in VS Code" Command="{Binding OpenInVsCodeCommand}" />
                <MenuItem Header="{Binding VsCodeExtensionText}" Command="{Binding InstallVsCodeExtensionCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="tool" Command="{Binding OpenInVisualStudioCommand}" ToolTip.Tip="Open this worktree's solution (.sln/.slnx) in Visual Studio">
            <StackPanel>
              <PathIcon Data="{StaticResource VisualStudioIcon}" Foreground="{x:Static t:Palette.VisualStudioPurple}" />
              <TextBlock Classes="label" Text="Visual Studio" />
            </StackPanel>
          </Button>
          <!-- The Total Git extension for Visual Studio (a Worktrees window), bundled with each release. -->
          <Button Classes="tool" MinWidth="0" Padding="2,4" Margin="-6,0,0,0" IsVisible="{Binding OffersVisualStudioExtension}"
                  ToolTip.Tip="The Total Git extension for Visual Studio">
            <PathIcon Data="{StaticResource ChevronIcon}" Width="10" Height="10" Foreground="{x:Static t:Palette.TextSecondary}">
              <PathIcon.RenderTransform>
                <RotateTransform Angle="90" />
              </PathIcon.RenderTransform>
            </PathIcon>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnVisualStudioMenuOpening">
                <MenuItem Header="Open in Visual Studio" Command="{Binding OpenInVisualStudioCommand}" />
                <MenuItem Header="{Binding VisualStudioExtensionText}" Command="{Binding InstallVisualStudioExtensionCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        </Viewbox>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,10,0">
          <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding BusyText}" Foreground="{x:Static t:Palette.TextMuted}" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding CommitCountText}" Foreground="{x:Static t:Palette.TextMuted}" IsVisible="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Classes="tool" Command="{Binding RefreshCommand}" IsEnabled="{Binding HasRepository}" ToolTip.Tip="Refresh (F5)">
            <StackPanel>
              <PathIcon Data="{StaticResource RefreshIcon}" />
              <TextBlock Classes="label" Text="Refresh" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Merge / rebase in progress -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding OperationBanner, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{x:Static t:Palette.OperationBanner}" Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Data="{StaticResource MergeIcon}" Width="16" Height="16" Foreground="{x:Static t:Palette.Warning}" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding OperationBanner.Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{x:Static t:Palette.BannerText}" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding OperationBanner.Actions}" Margin="12,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MenuAction">
              <Button Content="{Binding Header}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" IsEnabled="{Binding IsEnabled}" Padding="10,3" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Banner -->
    <Border x:Name="BannerBar" DockPanel.Dock="Top" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{Binding Banner.IsError, Converter={x:Static vm:Converters.ErrorToBackground}, FallbackValue=Transparent}">
      <Panel>
      <!-- Counts down to the banner closing itself (banners with actions stay). -->
      <ProgressBar VerticalAlignment="Bottom" Height="2" MinHeight="0" Minimum="0" Maximum="1" Value="{Binding BannerTimeLeft}"
                   IsVisible="{Binding BannerClosesItself}" Foreground="{x:Static t:Palette.BannerCountdown}" Background="Transparent" CornerRadius="0" />
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,8">
        <SelectableTextBlock Text="{Binding Banner.Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{x:Static t:Palette.BannerText}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Banner.Actions}" Margin="12,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MenuAction">
              <Button Content="{Binding Header}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" IsEnabled="{Binding IsEnabled}" Padding="10,3" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="2" Command="{Binding DismissBannerCommand}" Background="Transparent" Padding="6" Margin="8,0,0,0" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12" />
        </Button>
      </Grid>
      </Panel>
    </Border>

    <Grid x:Name="MainGrid" ColumnDefinitions="240,4,*,4,380">
      <!-- The folded sidebar (when unpinned): a thin rail; pointing at it opens the sidebar over the graph. -->
      <Border Grid.Column="0" x:Name="SidebarRail" IsVisible="False" Background="{x:Static t:Palette.Panel}" Cursor="Hand"
              BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,1,0" ToolTip.Tip="Branches, worktrees and pull requests (point to open)">
        <StackPanel Spacing="14" Margin="0,12,0,0" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource ChevronIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextSecondary}" />
          <PathIcon Data="{StaticResource BranchIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextMuted}" />
          <PathIcon Data="{StaticResource TagIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextMuted}" />
          <PathIcon Data="{StaticResource StashIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextMuted}" />
          <PathIcon Data="{StaticResource WorktreeIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextMuted}" />
          <PathIcon Data="{StaticResource PullRequestIcon}" Width="14" Height="14" Foreground="{x:Static t:Palette.TextMuted}" />
        </StackPanel>
      </Border>
      <views:SidebarView Grid.Column="0" x:Name="Sidebar" DataContext="{Binding Sidebar}" ZIndex="10" />
      <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" ResizeDirection="Columns" />

      <Panel Grid.Column="2">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*" IsVisible="{Binding HasRepository}">
          <!-- Graph filters: one developer, the current branch's line, folding rebased runs. -->
          <Border Grid.ColumnSpan="2" Background="{x:Static t:Palette.SubHeader}" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <Border.Styles>
              <Style Selector="ToggleButton.filter">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{x:Static t:Palette.BorderControl}" />
                <Setter Property="BorderThickness" Value="1" />
              </Style>
              <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{x:Static t:Palette.SelectedFill}" />
                <Setter Property="Foreground" Value="{x:Static t:Palette.SelectedFillText}" />
                <Setter Property="BorderBrush" Value="{x:Static t:Palette.AccentBorder}" />
              </Style>
            </Border.Styles>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox Text="{Binding HistoryQuery}" PlaceholderText="Search message, SHA or author" Width="220"
                         FontSize="12" MinHeight="26" Padding="8,2" ToolTip.Tip="{Binding HistorySearchDetail}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding NextHistoryMatchCommand}" />
                    <KeyBinding Gesture="Shift+Enter" Command="{Binding PreviousHistoryMatchCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Content="&#x2191;" Command="{Binding PreviousHistoryMatchCommand}" FontSize="12" Padding="7,2" MinHeight="26" ToolTip.Tip="Previous match (Shift+Enter)" />
                <Button Content="&#x2193;" Command="{Binding NextHistoryMatchCommand}" FontSize="12" Padding="7,2" MinHeight="26" ToolTip.Tip="Next match (Enter)" />
                <TextBlock Text="{Binding HistorySearchSummary}" ToolTip.Tip="{Binding HistorySearchDetail}" Foreground="{x:Static t:Palette.TextMuted}" FontSize="12"
                           VerticalAlignment="Center" Width="74" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ComboBox ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}" MinWidth="190" MaxDropDownHeight="420"
                        FontSize="12" MinHeight="26" Padding="8,2" ToolTip.Tip="Show only one developer's commits">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AuthorOption">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center"
                              Background="{Binding InitialsBrush}" IsVisible="{Binding !IsEveryone}">
                        <Panel>
                          <TextBlock Text="{Binding Initials}" FontSize="8" FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasAvatar}" />
                          <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                        </Panel>
                      </Border>
                      <PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14" Margin="2,0,10,0" Foreground="{x:Static t:Palette.TextMuted}"
                                IsVisible="{Binding IsEveryone}" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{x:Static t:Palette.TextDim}" Margin="12,0,0,0" VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ToggleButton Classes="filter" IsChecked="{Binding CurrentBranchOnly}"
                            ToolTip.Tip="Show only the current branch's line down to the main branch. Merged branches show as their merge commit.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource BranchIcon}" Width="12" Height="12" />
                  <TextBlock Text="Current branch only" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="filter" IsChecked="{Binding FoldRuns}"
                            ToolTip.Tip="Fold runs of 3 or more commits in a row on one branch into one row (a merge or another branch's commit ends a run). Click a folded row's arrow to open it.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource CollapseIcon}" Width="12" Height="12" />
                  <TextBlock Text="Fold commit runs" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasFilters}">
                <TextBlock Text="{Binding FilterSummary}" Foreground="{x:Static t:Palette.TextMuted}" FontSize="12" VerticalAlignment="Center" />
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" FontSize="12" Padding="8,2" MinHeight="24" />
              </StackPanel>
            </WrapPanel>
          </Border>
          <views:CommitGraphView Grid.Row="1" Grid.Column="0" x:Name="Graph" Data="{Binding Graph}" SelectedSha="{Binding SelectedSha}" SelectedRange="{Binding SelectedRange}">
            <views:CommitGraphView.Styles>
              <!-- Room for a pull request's hover card. -->
              <Style Selector="ToolTip">
                <Setter Property="MaxWidth" Value="420" />
              </Style>
            </views:CommitGraphView.Styles>
          </views:CommitGraphView>
          <TextBlock Grid.Row="1" Grid.Column="0" IsVisible="{Binding IsEmptyRepository}" IsHitTestVisible="False"
                     Text="No commits yet. Add files to this folder and they'll show here, ready for the first commit."
                     Foreground="{x:Static t:Palette.TextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
          <ScrollBar Grid.Row="1" Grid.Column="1" x:Name="GraphScrollBar" Orientation="Vertical" AllowAutoHide="False" />
        </Grid>

        <!-- Conflicted files open the merge tool over the graph. -->
        <Panel IsVisible="{Binding HasMergeTool}" ZIndex="1">
          <views:MergeToolView DataContext="{Binding MergeTool}" />
        </Panel>

        <!-- Diff replaces the graph while a file is open, like GitKraken. -->
        <DockPanel IsVisible="{Binding HasDiff}" Background="{x:Static t:Palette.Surface}">
          <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.Panel}" Padding="12,6" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <TextBlock Text="{Binding DiffTitle}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                         Foreground="{x:Static t:Palette.TextPrimary}" TextTrimming="CharacterEllipsis" />
              <!-- Changes only | whole file -->
              <ToggleButton Grid.Column="1" IsChecked="{Binding WholeFileDiff}" Padding="10,3" Margin="12,0,0,0" CornerRadius="4"
                            ToolTip.Tip="Show the whole file with the changes marked, not just the changed parts">
                <ToggleButton.Styles>
                  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{x:Static t:Palette.SelectedFill}" />
                    <Setter Property="Foreground" Value="{x:Static t:Palette.SelectedFillText}" />
                  </Style>
                </ToggleButton.Styles>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource ExpandIcon}" Width="12" Height="12" />
                  <TextBlock Text="Whole file" FontSize="12" />
                </StackPanel>
              </ToggleButton>
              <!-- Inline | Side by side -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,10,0">
                <Button Classes="seg" Classes.active="{Binding IsInlineDiff}" Command="{Binding SetDiffModeCommand}"
                              CommandParameter="{x:Static vm:DiffViewMode.Inline}" Padding="10,3" CornerRadius="4,0,0,4"
                              ToolTip.Tip="Inline diff">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource InlineDiffIcon}" Width="12" Height="12" />
                    <TextBlock Text="Inline" FontSize="12" />
                  </StackPanel>
                </Button>
                <Button Classes="seg" Classes.active="{Binding IsSplitDiff}" Command="{Binding SetDiffModeCommand}"
                              CommandParameter="{x:Static vm:DiffViewMode.Split}" Padding="10,3" CornerRadius="0,4,4,0"
                              ToolTip.Tip="Side-by-side diff">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource SplitDiffIcon}" Width="12" Height="12" />
                    <TextBlock Text="Side by side" FontSize="12" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <ToggleButton Grid.Column="3" IsChecked="{Binding IgnoreWhitespace}" Padding="10,3" Margin="0,0,10,0" CornerRadius="4"
                            ToolTip.Tip="Hide whitespace-only changes (git diff -w). Files and staging are unchanged.">
                <ToggleButton.Styles>
                  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{x:Static t:Palette.SelectedFill}" />
                    <Setter Property="Foreground" Value="{x:Static t:Palette.SelectedFillText}" />
                  </Style>
                </ToggleButton.Styles>
                <TextBlock Text="Ignore whitespace" FontSize="12" />
              </ToggleButton>
              <Button Grid.Column="4" Command="{Binding CloseDiffCommand}" Padding="10,3" ToolTip.Tip="Close (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" />
                  <TextBlock Text="Close" FontSize="12" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <views:DiffView x:Name="DiffView" Diff="{Binding Diff}" Mode="{Binding DiffMode}" />
            <!-- Where the changes are, drawn under the (see-through) scroll bar -->
            <Panel Grid.Column="1">
              <views:DiffScrollMarks x:Name="DiffMarks" />
              <ScrollBar x:Name="DiffScrollBar" Classes="diffMarks" Orientation="Vertical" AllowAutoHide="False" />
            </Panel>
            <!-- One sideways scroll for both sides of a side-by-side diff, so their lines stay level. -->
            <ScrollBar Grid.Row="1" x:Name="DiffHScrollBar" Orientation="Horizontal" AllowAutoHide="False" IsVisible="False" />
          </Grid>
        </DockPanel>

        <!-- A new tab: open a folder, or pick one of the repositories opened before. -->
        <ScrollViewer IsVisible="{Binding ShowEmptyState}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="40,36" Spacing="14" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Open a repository" FontSize="20" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
                <TextBlock Text="Pick one you've opened before, or open another folder." Foreground="{x:Static t:Palette.TextMuted}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="accent" Command="{Binding OpenRepositoryCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="13" Height="13" />
                  <TextBlock Text="Open folder…" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRecent}" Margin="0,10,0,0">
              <TextBlock Text="RECENT" FontSize="10.5" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextHeader}" LetterSpacing="0.8" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding RecentFilter}" PlaceholderText="Filter" Width="220" IsVisible="{Binding ShowRecentFilter}" />
            </Grid>

            <ItemsControl x:Name="RecentTiles" ItemsSource="{Binding RecentItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentRepositoryItem">
                  <Button Classes="recentTile" Classes.missing="{Binding IsMissing}" Width="272" Height="104" Margin="0,0,12,12" Padding="0"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          Command="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).OpenRecentCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}"
                          Opacity="{Binding Exists, Converter={x:Static vm:Converters.DimWhenFalse}}">
                    <Panel>
                      <Border Background="{Binding Tint}" CornerRadius="6" />
                      <Border Width="4" HorizontalAlignment="Left" Background="{Binding Accent}" CornerRadius="6,0,0,6" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*,Auto" Margin="14,10,10,10">
                        <Panel Grid.RowSpan="2" Width="28" Height="28" Margin="0,2,10,0" VerticalAlignment="Top">
                          <Image Source="{Binding Icon}" Width="22" Height="22" IsVisible="{Binding HasIcon}" />
                          <PathIcon Data="{StaticResource FolderIcon}" Width="20" Height="20" Foreground="{x:Static t:Palette.TextMuted}" IsVisible="{Binding HasNoIcon}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,22,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
                          <Image Source="{Binding BranchIcon}" Width="12" Height="12" IsVisible="{Binding HasBranchIcon}" VerticalAlignment="Center" />
                          <PathIcon Data="{StaticResource BranchIcon}" Width="11" Height="11" Foreground="{x:Static t:Palette.TextMuted}" VerticalAlignment="Center">
                            <PathIcon.IsVisible>
                              <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasBranch" />
                                <Binding Path="!HasBranchIcon" />
                              </MultiBinding>
                            </PathIcon.IsVisible>
                          </PathIcon>
                          <TextBlock Text="{Binding BranchDisplay}" FontSize="12" Foreground="{x:Static t:Palette.BranchText}" IsVisible="{Binding HasBranch}"
                                     FontFamily="Cascadia Mono, Consolas, monospace" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                          <TextBlock Text="Folder not found" FontSize="12" Foreground="{x:Static t:Palette.Failure}" IsVisible="{Binding IsMissing}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Path}" FontSize="11" Foreground="{x:Static t:Palette.TextDim}"
                                   TextTrimming="LeadingCharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding OpenedText}" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,2" />
                      </Grid>
                      <!-- Forget this repository (only the entry; nothing on disk changes). -->
                      <Button Classes="tileRemove" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                              ToolTip.Tip="Remove from recent"
                              Command="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).RemoveRecentCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="9" Height="9" />
                      </Button>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding IsLoading}" Text="Loading repository..." FontSize="16"
                   Foreground="{x:Static t:Palette.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="600">
          <TextBlock Text="{Binding LoadError}" Foreground="{x:Static t:Palette.Error}" TextWrapping="Wrap" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="Trust this folder" Command="{Binding TrustFolderCommand}" Classes="accent" IsVisible="{Binding CanTrustFolder}"
                    ToolTip.Tip="{Binding UntrustedPath, StringFormat='Adds {0} to the safe.directory list in your global git config'}" />
            <Button Content="Open a different repository..." Command="{Binding OpenRepositoryCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <Panel Grid.Column="4" Background="{x:Static t:Palette.Panel}">
        <views:CommitDetailsView x:Name="DetailsView" DataContext="{Binding Details}" IsVisible="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).ShowDetails}" />
        <views:StagingView x:Name="StagingPane" DataContext="{Binding Staging}" IsVisible="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).ShowStaging}" />
        <views:WorktreeChangesView x:Name="WorktreeChangesPane" DataContext="{Binding WorktreeChanges}" IsVisible="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).ShowWorktreeChanges}" />
        <views:CommitRangeView DataContext="{Binding Range}" IsVisible="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).ShowRange}" />
        <views:NewBranchView DataContext="{Binding NewBranch}" IsVisible="{Binding $parent[views:RepositoryView].((vm:RepositoryViewModel)DataContext).ShowNewBranch}" />
        <TextBlock Text="Select a commit to see its details" Foreground="{x:Static t:Palette.TextMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!ShowDetails" />
              <Binding Path="!ShowStaging" />
              <Binding Path="!ShowWorktreeChanges" />
              <Binding Path="!ShowRange" />
              <Binding Path="!ShowNewBranch" />
              <Binding Path="HasRepository" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
