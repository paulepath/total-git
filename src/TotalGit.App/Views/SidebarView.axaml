<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:views="using:TotalGit.App.Views"
             x:Class="TotalGit.App.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="BranchIcon">M13,14C9.64,14 8.54,15.35 8.18,16.24C9.25,16.7 10,17.76 10,19A3,3 0 0,1 7,22A3,3 0 0,1 4,19C4,17.69 4.83,16.58 6,16.17V7.83C4.83,7.42 4,6.31 4,5A3,3 0 0,1 7,2A3,3 0 0,1 10,5C10,6.31 9.17,7.42 8,7.83V13.12C8.88,12.47 10.16,12 12,12C14.67,12 15.56,10.66 15.85,9.77C14.77,9.32 14,8.25 14,7A3,3 0 0,1 17,4A3,3 0 0,1 20,7C20,8.34 19.12,9.5 17.91,9.86C17.65,11.29 16.68,14 13,14M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18M7,4A1,1 0 0,0 6,5A1,1 0 0,0 7,6A1,1 0 0,0 8,5A1,1 0 0,0 7,4M17,6A1,1 0 0,0 16,7A1,1 0 0,0 17,8A1,1 0 0,0 18,7A1,1 0 0,0 17,6Z</StreamGeometry>
    <StreamGeometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
    <StreamGeometry x:Key="TagIcon">M5.5,7A1.5,1.5 0 0,1 4,5.5A1.5,1.5 0 0,1 5.5,4A1.5,1.5 0 0,1 7,5.5A1.5,1.5 0 0,1 5.5,7M21.41,11.58L12.41,2.58C12.05,2.22 11.55,2 11,2H4C2.89,2 2,2.89 2,4V11C2,11.55 2.22,12.05 2.59,12.41L11.58,21.41C11.95,21.77 12.45,22 13,22C13.55,22 14.05,21.77 14.41,21.41L21.41,14.41C21.78,14.05 22,13.55 22,13C22,12.45 21.77,11.94 21.41,11.58Z</StreamGeometry>
    <StreamGeometry x:Key="WorktreeIcon">M3,3H9V7H3V3M15,10H21V14H15V10M15,17H21V21H15V17M13,13H7V18H13V20H7L5,20V9H7V11H13V13Z</StreamGeometry>
    <StreamGeometry x:Key="CheckIcon">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:PrCardViewModel">
      <views:PrHoverCard />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
    </Style>
    <Style Selector="TextBlock.label.group">
      <Setter Property="Foreground" Value="#8A9099" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ticket">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="16" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="#2C3440" />
      <Setter Property="Foreground" Value="#9DB8D6" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ticket:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#34506E" />
      <Setter Property="Foreground" Value="#D6E7F8" />
    </Style>
    <Style Selector="TreeViewItem" x:DataType="vm:SidebarNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
      <!-- The ✓ can be squeezed out by a long name, so the current row is tinted as well. -->
      <Setter Property="Background" Value="{Binding IsCurrent, Converter={x:Static vm:Converters.CurrentRowBrush}}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#D5D8DD" />
    </Style>
    <Style Selector="TextBlock.label.section">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label.dimmed">
      <Setter Property="Foreground" Value="#6B727C" />
    </Style>
    <Style Selector="TextBlock.label.current">
      <Setter Property="Foreground" Value="#4CC38A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="PathIcon.node">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="#8A9099" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="#23272D">
    <Border DockPanel.Dock="Top" Padding="8,8,8,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox x:Name="FilterBox" Text="{Binding Filter}" PlaceholderText="Filter (Ctrl+Alt+F)" FontSize="12"
                 MinHeight="28" Padding="6,4">
          <TextBox.InnerRightContent>
            <PathIcon Data="{StaticResource SearchIcon}" Width="12" Height="12" Margin="0,0,8,0" Foreground="#8A9099" />
          </TextBox.InnerRightContent>
        </TextBox>
        <!-- Pinned: the sidebar stays open. Unpinned: it folds to a thin rail and opens while the pointer is over it. -->
        <Button Grid.Column="1" Margin="6,0,0,0" Padding="6,0" MinHeight="28" Background="Transparent" Click="OnRulesClick"
                ToolTip.Tip="Branch icons and grouping">
          <PathIcon Data="{StaticResource CogIcon}" Width="13" Height="13" Foreground="#A9AFB8" />
        </Button>
        <ToggleButton Grid.Column="2" x:Name="PinButton" Margin="6,0,0,0" Padding="6,0" MinHeight="28" Background="Transparent"
                      ToolTip.Tip="Keep the sidebar open (unpin to fold it away until you point at it)">
          <Panel>
            <PathIcon Data="{StaticResource PinIcon}" Width="13" Height="13"
                      IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
            <PathIcon Data="{StaticResource PinOffIcon}" Width="13" Height="13" Foreground="#8A9099"
                      IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />
          </Panel>
        </ToggleButton>
      </Grid>
    </Border>

    <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:SidebarNode">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="24" Background="Transparent">
            <!-- Icons -->
            <Panel Grid.Column="0" VerticalAlignment="Center">
              <PathIcon Classes="node" Data="{StaticResource BranchIcon}" IsVisible="{Binding ShowBranchGlyph}" />
              <PathIcon Classes="node" Data="{StaticResource FolderIcon}" IsVisible="{Binding ShowFolderGlyph}" />
              <PathIcon Classes="node" Data="{StaticResource TagIcon}" IsVisible="{Binding IsTag}" />
              <PathIcon Classes="node" Data="{StaticResource StashIcon}" IsVisible="{Binding IsStash}" />
              <PathIcon Classes="node" Data="{StaticResource WorktreeIcon}" IsVisible="{Binding ShowWorktreeGlyph}" />
              <StackPanel IsVisible="{Binding IsPullRequest}" Orientation="Horizontal" VerticalAlignment="Center" Margin="-14,0,0,0">
                <Border Width="3" Height="16" CornerRadius="1.5" Background="{Binding RailBrush}" Margin="-4,0,6,0" />
                <Border Width="16" Height="16" CornerRadius="8" ClipToBounds="True" Background="{Binding Author.InitialsBrush}" Margin="0,0,6,0">
                  <Panel>
                    <TextBlock Text="{Binding Author.Initials}" FontSize="7.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Author.HasAvatar}" />
                    <Image Source="{Binding Author.Avatar}" Stretch="UniformToFill" IsVisible="{Binding Author.HasAvatar}" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding NumberText}" Width="26" Margin="0,0,5,0" TextAlignment="Right" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" Foreground="#8A9099" />
                <Button Classes="ticket" Content="{Binding Ticket}" IsVisible="{Binding HasTicket}" Click="OnTicketClick"
                        ToolTip.Tip="{Binding Ticket, StringFormat='Open {0} in Jira (right-click to change the Jira address)'}" />
              </StackPanel>
              <Image Source="{Binding KindIcon}" IsVisible="{Binding HasKindIcon}" Width="14" Height="14" Margin="-1,0,5,0" />
            </Panel>

            <!-- The label always wins; the markers and grey subtitle only appear when they fit whole
                 (they are in the tooltip too). -->
            <views:PriorityRowPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
              <TextBlock Classes="label" Classes.section="{Binding IsSection}" Classes.dimmed="{Binding IsDimmed}" Classes.group="{Binding IsPrGroup}"
                         Classes.current="{Binding IsCurrent}" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
              <PathIcon Data="{StaticResource CheckIcon}" Width="11" Height="11" Foreground="#4CC38A" IsVisible="{Binding IsCurrent}" />
              <PathIcon Data="{StaticResource WorktreeIcon}" Width="11" Height="11" Foreground="#8A9099" IsVisible="{Binding HasWorktree}" />
              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#6B727C" IsVisible="{Binding HasSubtitle}" />
            </views:PriorityRowPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="4,0,8,0" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#4CC38A" VerticalAlignment="Center" IsVisible="{Binding ShowCurrentDot}"
                       ToolTip.Tip="Contains the current branch" />
              <TextBlock Text="{Binding Ahead}" FontSize="11" Foreground="#4CC38A" IsVisible="{Binding HasAhead}" />
              <TextBlock Classes="behind" Text="{Binding Behind}" FontSize="11" Foreground="#E8B339" IsVisible="{Binding HasBehind}"
                         Background="Transparent" ToolTip.Tip="New commits on the remote branch. Double-click to bring them into this branch." />
              <PathIcon Classes="gone" Data="{StaticResource CloseIcon}" Width="9" Height="9" Foreground="#E5484D" VerticalAlignment="Center"
                        IsVisible="{Binding IsUpstreamGone}" Background="Transparent"
                        ToolTip.Tip="Deleted on the remote. Double-click to clean up branches deleted on the remote." />
              <StackPanel Orientation="Horizontal" Spacing="-4" IsVisible="{Binding HasReviewers}" VerticalAlignment="Center" Margin="2,0,0,0">
                <ItemsControl ItemsSource="{Binding Reviewers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="-4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PrPerson">
                      <Panel Width="16" Height="16" ToolTip.Tip="{Binding ToolTip}" Background="Transparent">
                        <Border Width="16" Height="16" CornerRadius="8" ClipToBounds="True" BorderBrush="#1E2227" BorderThickness="1.5"
                                Background="{Binding InitialsBrush}">
                          <Panel>
                            <TextBlock Text="{Binding Initials}" FontSize="7" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasAvatar}" />
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                          </Panel>
                        </Border>
                        <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" Stroke="#1E2227" StrokeThickness="1"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasState}" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding MoreReviewers}" FontSize="10" Foreground="#8A9099" VerticalAlignment="Center" Margin="6,0,0,0"
                           IsVisible="{Binding HasMoreReviewers}" />
              </StackPanel>
              <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#5AA9F2" IsVisible="{Binding ShowCount}" />
              <Button IsVisible="{Binding IsPullRequestsSection}" Padding="4,0" MinHeight="0" Height="18" Background="Transparent"
                      ToolTip.Tip="Refresh pull requests" Click="OnRefreshPullRequestsClick">
                <PathIcon Data="{StaticResource RefreshIcon}" Width="11" Height="11" Foreground="#A9AFB8" />
              </Button>
              <Button Content="+" IsVisible="{Binding IsWorktreesSection}" Padding="6,0" MinHeight="0" Height="18" FontSize="12"
                      ToolTip.Tip="Create worktree with new branch" Click="OnAddWorktreeClick" />
            </StackPanel>
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
