<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TotalGit.App.ViewModels"
        xmlns:views="using:TotalGit.App.Views"
        x:Class="TotalGit.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1500" Height="900"
        Background="{StaticResource WindowBackgroundBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding SelectedTab.RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRepositoryCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding SelectedTab.CloseDiffCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="ListBox#TabStrip ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Background" Value="#1F2328" />
    </Style>
    <Style Selector="ListBox#TabStrip ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#262A31" />
    </Style>
    <!-- The selected tab joins the toolbar below it. -->
    <Style Selector="ListBox#TabStrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ToolbarBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox#TabStrip ListBoxItem:selected TextBlock.tabTitle">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.tabClose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBox#TabStrip ListBoxItem:selected Button.tabClose, ListBox#TabStrip ListBoxItem:pointerover Button.tabClose">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Tab strip -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Background="#16191D">
      <ListBox Grid.Column="0" x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
               Background="Transparent" Margin="6,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RepositoryViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="32" MinWidth="120" MaxWidth="240" Background="Transparent"
                  ToolTip.Tip="{Binding TabPath}">
              <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" Margin="12,0,8,0" Foreground="#8A9099" />
              <TextBlock Grid.Column="1" Classes="tabTitle" Text="{Binding TabTitle}" FontSize="12" Foreground="#A9AFB8"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="tabClose" Margin="6,0,6,0" ToolTip.Tip="Close tab (Ctrl+W)"
                      Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}">
                <PathIcon Data="{StaticResource CloseIcon}" Width="9" Height="9" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button Grid.Column="1" Command="{Binding NewTabCommand}" Background="Transparent" Padding="8" Margin="4,6,0,0"
              VerticalAlignment="Center" ToolTip.Tip="New tab (Ctrl+T)">
        <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12" Foreground="#A9AFB8" />
      </Button>

      <!-- Shown once an update has downloaded; stays until the user restarts. -->
      <Button Grid.Column="3" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding HasUpdate}" Background="Transparent"
              Padding="10,4" Margin="0,4,8,0" VerticalAlignment="Center"
              ToolTip.Tip="{Binding UpdateVersion, StringFormat='TotalGit {0} is ready. Restart to update.'}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource UpdateIcon}" Width="14" Height="14" Foreground="#4CC38A" />
          <TextBlock Text="Restart to update" FontSize="12" Foreground="#4CC38A" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- One view per tab, only the selected one visible, so each keeps its scroll position and selection. -->
    <ItemsControl x:Name="TabViews" ItemsSource="{Binding Tabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RepositoryViewModel">
          <views:RepositoryView IsVisible="{Binding IsSelected}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>
