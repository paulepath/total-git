<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:t="using:TotalGit.App.Services"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:views="using:TotalGit.App.Views"
             x:Class="TotalGit.App.Views.PullRequestReviewView"
             x:DataType="vm:PullRequestReviewViewModel"
             Background="{x:Static t:Palette.Surface}">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.TextHeader}" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.Accent}" />
    </Style>
    <Style Selector="Button.small.ready">
      <Setter Property="Background" Value="{x:Static t:Palette.GreenButton}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.small.ready:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.GreenButtonHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToggleButton.small:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.SelectedFill}" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.SelectedFillText}" />
    </Style>
    <!-- The open file's Approve / Reject switch. -->
    <Style Selector="Button.seg.approvedOn">
      <Setter Property="Background" Value="{x:Static t:Palette.ApproveButton}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.seg.approvedOn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.ApproveButtonHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.seg.rejectedOn">
      <Setter Property="Background" Value="{x:Static t:Palette.RejectButton}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.seg.rejectedOn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.RejectButtonHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- The review box: ☐ not reviewed, ☑ approved (green), ☒ rejected (red), ◩ changed since, in the verdict's colour. -->
    <Style Selector="Button.reviewBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.tab">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.commitRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.commitRow.selected">
      <Setter Property="Background" Value="{x:Static t:Palette.BranchChip}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="BorderBrush" Value="{x:Static t:Palette.AccentBorder}" />
      <Setter Property="Background" Value="{x:Static t:Palette.Panel}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: title, branches, ticket and the actions -->
    <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.Panel}" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="4">
          <SelectableTextBlock TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextHeading}">
            <Run Text="{Binding NumberText}" Foreground="{x:Static t:Palette.TextMuted}" FontWeight="Normal" />
            <Run Text="{Binding Pr.Title}" />
          </SelectableTextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{x:Static t:Palette.NeutralChip}" CornerRadius="9" Padding="7,1" IsVisible="{Binding Pr.IsDraft}">
              <TextBlock Text="Draft" FontSize="11" Foreground="{x:Static t:Palette.TextSoft}" />
            </Border>
            <Border Background="{x:Static t:Palette.BranchChip}" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding BranchesText}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{x:Static t:Palette.BranchText}" />
            </Border>
            <Button Classes="link" IsVisible="{Binding HasTicket}" Command="{Binding OpenTicketCommand}" ToolTip.Tip="Open the ticket">
              <TextBlock Text="{Binding Ticket}" FontFamily="Cascadia Mono, Consolas, monospace" />
            </Button>
            <TextBlock Text="{Binding AuthorText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Pr.StatsText}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <ProgressBar IsIndeterminate="True" Width="50" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BusyText}" Classes="muted" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          <Button Classes="small" Command="{Binding LoadCommand}" ToolTip.Tip="Reload the pull request (F5)">
            <PathIcon Data="{StaticResource RefreshIcon}" Width="12" Height="12" />
          </Button>
          <Border Background="{x:Static t:Palette.PurpleFill}" CornerRadius="9" Padding="8,2" IsVisible="{Binding IsLocal}" VerticalAlignment="Center"
                  ToolTip.Tip="Changes that aren't in a pull request: review boxes are kept on this machine; no comments or checks.">
            <TextBlock Text="Local review" FontSize="11" Foreground="{x:Static t:Palette.PurpleText}" />
          </Border>
          <Button Classes="small" Command="{Binding OpenInBrowserCommand}" ToolTip.Tip="Open on the web" IsVisible="{Binding IsPullRequest}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource BrowserIcon}" Width="12" Height="12" />
              <TextBlock Text="Open on web" />
            </StackPanel>
          </Button>
          <Button Classes="small" Command="{Binding CheckoutCommand}" ToolTip.Tip="Check the pull request out into a new worktree" IsVisible="{Binding IsPullRequest}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource WorktreeIcon}" Width="12" Height="12" />
              <TextBlock Text="Check out" />
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding HasSuggestionBatch}">
            <Button Classes="small" Background="{x:Static t:Palette.GreenButton}" Foreground="White" CornerRadius="4,0,0,4" Command="{Binding CommitSuggestionBatchCommand}"
                    Content="{Binding CommitBatchText}" ToolTip.Tip="Commit the suggestions you gathered in one commit, and push it" />
            <Button Classes="small" Background="{x:Static t:Palette.GreenButtonDark}" Foreground="White" CornerRadius="0,4,4,0" Command="{Binding ClearSuggestionBatchCommand}"
                    ToolTip.Tip="Empty the batch">
              <PathIcon Data="{StaticResource CloseIcon}" Width="9" Height="9" />
            </Button>
          </StackPanel>
          <Button Classes="accent small" Command="{Binding SubmitReviewCommand}" IsVisible="{Binding Pr.CanReview}"
                  ToolTip.Tip="Submit your review: comment, approve or request changes, with your pending line comments">
            <TextBlock Text="{Binding ReviewButtonText}" />
          </Button>
          <!-- Green with a tick once it's ready; plain otherwise (GitHub may still refuse, and says why). -->
          <Button Classes="small" Classes.ready="{Binding IsReadyToMerge}" Command="{Binding MergeCommand}" IsVisible="{Binding CanMerge}"
                  ToolTip.Tip="{Binding MergeToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource MergeIcon}" Width="12" Height="12" />
              <TextBlock Text="Merge…" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" BorderBrush="{Binding Pr.MergeBrush}" BorderThickness="3,0,0,0"
                Background="{x:Static t:Palette.SubtleFill}" Padding="8,4" CornerRadius="2" HorizontalAlignment="Left"
                IsVisible="{Binding Pr.MergeText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Pr.MergeText}" FontSize="12" Foreground="{x:Static t:Palette.TextStrong}" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Border>

    <!-- Messages: errors stay until dismissed -->
    <Border DockPanel.Dock="Top" Padding="16,6" IsVisible="{Binding HasMessage}"
            Background="{Binding MessageIsError, Converter={x:Static views:ReviewConverters.MessageBackground}}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Message}" Foreground="{x:Static t:Palette.TextHeading}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,6,0" IsVisible="{Binding MessageIsError}">
          <Button Classes="small" Content="Report" Command="{Binding ReportErrorCommand}"
                  ToolTip.Tip="Open a GitHub issue filled in with this error, Total Git's version and its recent log, for you to check and submit" />
          <Button Classes="small" Content="Copy details" Command="{Binding CopyErrorDetailsCommand}"
                  ToolTip.Tip="Copy the same details, to paste into an email or chat" />
        </StackPanel>
        <Button Grid.Column="2" Classes="small" Background="Transparent" Command="{Binding DismissMessageCommand}" ToolTip.Tip="Dismiss">
          <PathIcon Data="{StaticResource CloseIcon}" Width="9" Height="9" />
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="Panes" ColumnDefinitions="290,4,*,4,360">
      <!-- Left: the files, with review boxes and progress -->
      <DockPanel Grid.Column="0" Background="{x:Static t:Palette.Gutter}">
        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6" Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="section" Text="FILES" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11.5" Foreground="{x:Static t:Palette.TextBody}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="2" Classes="small" IsChecked="{Binding ShowAsTree}" Margin="8,0,0,0" Padding="6,3"
                          ToolTip.Tip="Group files by folder">
              <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" />
            </ToggleButton>
          </Grid>
          <views:ReviewProgressBar Approved="{Binding ApprovedCount}" Rejected="{Binding RejectedCount}" Changed="{Binding ChangedCount}"
                                   Total="{Binding Files.Count}" />
          <TextBlock Text="{Binding ProgressDetail}" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" TextWrapping="Wrap" />
          <Border Background="{x:Static t:Palette.BranchChip}" BorderBrush="{x:Static t:Palette.AccentBorder}" BorderThickness="3,0,0,0" CornerRadius="2" Padding="8,4" IsVisible="{Binding IsCommitView}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding CommitViewText}" FontSize="11.5" Foreground="{x:Static t:Palette.InfoText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding CommitViewText}" />
              <Button Grid.Column="1" Classes="small" Content="All changes" Command="{Binding ShowAllCommitsCommand}" Margin="6,0,0,0" />
            </Grid>
          </Border>
          <ToggleButton Classes="small" IsChecked="{Binding SinceLastReview}" IsVisible="{Binding CanShowSinceLastReview}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="{Binding SinceLastReviewText}">
            <TextBlock Text="Only what changed since my last review" FontSize="11.5" />
          </ToggleButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,6">
          <CheckBox Content="Hide approved files" IsChecked="{Binding HideReviewed}" FontSize="12" />
          <CheckBox Content="Show only rejected files" IsChecked="{Binding OnlyRejected}" FontSize="12" IsVisible="{Binding HasRejected}" />
          <CheckBox Content="{Binding HideTestsText}" IsChecked="{Binding HideTests}" FontSize="12" IsVisible="{Binding HasTests}"
                    ToolTip.Tip="Leave test files out of the list and out of Next, to review them later" />
        </StackPanel>
        <TreeView x:Name="FileList" ItemsSource="{Binding FileNodes}" SelectedItem="{Binding SelectedNode}" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:ReviewTreeNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="0,2" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:ReviewTreeNode" ItemsSource="{Binding Children}">
              <Panel>
                <!-- Folder: name and how many of its files are reviewed -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsFolder}" Background="Transparent">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" Foreground="{x:Static t:Palette.TextMuted}" Margin="2,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding ReviewedText}" FontSize="10.5" Foreground="{x:Static t:Palette.TextDim}" Margin="6,0,4,0" VerticalAlignment="Center" />
                </Grid>
                <!-- File: review box, status, name, comments, size -->
                <Grid Classes="fileRow" ColumnDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding IsFile}" ToolTip.Tip="{Binding File.ToolTip}" Background="Transparent"
                      Opacity="{Binding File.IsGenerated, FallbackValue=1, Converter={x:Static views:ReviewConverters.GeneratedOpacity}}">
                  <Button Classes="reviewBox" ToolTip.Tip="{Binding File.StateText}"
                          Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).ToggleReviewedCommand}"
                          CommandParameter="{Binding File}">
                    <views:ReviewBox State="{Binding File.State, FallbackValue=NotReviewed}" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding File.StatusLetter}" Foreground="{Binding File.StatusBrush}" FontSize="11" FontWeight="Bold"
                             Width="14" VerticalAlignment="Center" Margin="4,0,2,0" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- A long name fades out before the comments and line counts, which always show whole -->
                    <views:FadeOverflow>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" />
                        <Border Background="{x:Static t:Palette.TestChip}" CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                                IsVisible="{Binding File.IsTest, FallbackValue=False}">
                          <TextBlock Text="test" FontSize="9.5" Foreground="{x:Static t:Palette.ChipText}" />
                        </Border>
                      </StackPanel>
                    </views:FadeOverflow>
                    <TextBlock Text="{Binding File.Folder}" FontSize="10.5" Foreground="{x:Static t:Palette.TextDim}" TextTrimming="LeadingCharacterEllipsis">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="ShowFolder" />
                          <Binding Path="File.HasFolder" FallbackValue="False" />
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="6,0,0,0"
                              IsVisible="{Binding File.HasThreads, FallbackValue=False}" ToolTip.Tip="Open comment threads">
                    <PathIcon Data="{StaticResource CommentIcon}" Width="11" Height="11" Foreground="{x:Static t:Palette.TextMuted}" />
                    <TextBlock Text="{Binding File.ThreadText}" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,4,0">
                    <TextBlock Text="{Binding File.AddedText}" FontSize="10.5" Foreground="{x:Static t:Palette.Success}" FontFamily="Cascadia Mono, Consolas, monospace" />
                    <TextBlock Text="{Binding File.DeletedText}" FontSize="10.5" Foreground="{x:Static t:Palette.Failure}" FontFamily="Cascadia Mono, Consolas, monospace" />
                  </StackPanel>
                </Grid>
              </Panel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{x:Static t:Palette.Splitter}" />

      <!-- Middle: the overview, or the one open file -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.SubHeader}" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="OverviewTab" Classes="tab" Classes.active="{Binding IsOverview}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource PullRequestIcon}" Width="12" Height="12" Foreground="{x:Static t:Palette.TextSecondary}" />
                <TextBlock Text="Overview" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" />
              </StackPanel>
            </Border>
            <Border Classes="tab active" IsVisible="{Binding HasOpenFile}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <views:ReviewBox State="{Binding SelectedFile.State}" />
                <TextBlock Text="{Binding OpenFileTitle}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Panel>
          <!-- Overview -->
          <ScrollViewer IsVisible="{Binding IsOverview}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,16" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
              <TextBlock Text="Loading the pull request…" Classes="muted" IsVisible="{Binding IsLoading}" />

              <!-- Since the last review -->
              <Border Background="{x:Static t:Palette.PurpleFill}" BorderBrush="{x:Static t:Palette.Purple}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="12,8"
                      IsVisible="{Binding CanShowSinceLastReview}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SinceLastReviewText}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="small" Content="Show only those" Command="{Binding ShowSinceLastReviewCommand}" Margin="12,0,0,0" />
                </Grid>
              </Border>

              <!-- Description -->
              <StackPanel Spacing="6" IsVisible="{Binding IsPullRequest}">
                <TextBlock Classes="section" Text="DESCRIPTION" />
                <Border Background="{x:Static t:Palette.Panel}" CornerRadius="4" Padding="12,10">
                  <Panel>
                    <views:MarkdownView Markdown="{Binding Pr.Body}" IsVisible="{Binding Pr.HasBody}" />
                    <TextBlock Text="No description." Classes="muted" IsVisible="{Binding !Pr.HasBody}" />
                  </Panel>
                </Border>
              </StackPanel>

              <!-- Reviewers and checks side by side -->
              <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding IsPullRequest}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="section" Text="REVIEWERS" />
                  <TextBlock Text="No reviewers yet." Classes="muted" IsVisible="{Binding !Pr.HasReviewers}" />
                  <ItemsControl ItemsSource="{Binding Pr.Reviewers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReviewerItem">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" />
                          <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="section" Text="{Binding Pr.ChecksTabText, Converter={x:Static views:ReviewConverters.Upper}}" />
                  <TextBlock Text="No checks." Classes="muted" IsVisible="{Binding !Pr.HasChecks}" />
                  <ItemsControl ItemsSource="{Binding Pr.Checks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CheckItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                          <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" />
                          <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <!-- Files: review state, size and comments -->
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="FILES" />
                  <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Classes="muted" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SourceFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewFileItem">
                      <Grid Classes="fileRow" ColumnDefinitions="Auto,*,130,Auto,Auto" Margin="0,1" Background="Transparent">
                        <Button Classes="reviewBox" ToolTip.Tip="{Binding StateText}"
                                Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).ToggleReviewedCommand}"
                                CommandParameter="{Binding}">
                          <views:ReviewBox State="{Binding State}" />
                        </Button>
                        <Button Grid.Column="1" Classes="link" HorizontalAlignment="Left" Padding="6,0" ToolTip.Tip="Open the file"
                                Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).OpenFileCommand}"
                                CommandParameter="{Binding}">
                          <TextBlock FontSize="12.5" TextTrimming="LeadingCharacterEllipsis">
                            <Run Text="{Binding Folder, StringFormat='{}{0}/'}" Foreground="{x:Static t:Palette.TextDim}" />
                            <Run Text="{Binding FileName}" Foreground="{x:Static t:Palette.TextPrimary}" />
                          </TextBlock>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                          <Border Background="{x:Static t:Palette.Success}" Width="{Binding AddedBarWidth}" Height="6" CornerRadius="1" />
                          <Border Background="{x:Static t:Palette.Failure}" Width="{Binding DeletedBarWidth}" Height="6" CornerRadius="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding HasThreads}">
                          <PathIcon Data="{StaticResource CommentIcon}" Width="11" Height="11" Foreground="{x:Static t:Palette.TextMuted}" />
                          <TextBlock Text="{Binding ThreadText}" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="80">
                          <TextBlock Text="{Binding AddedText}" FontSize="11" Foreground="{x:Static t:Palette.Success}" FontFamily="Cascadia Mono, Consolas, monospace" />
                          <TextBlock Text="{Binding DeletedText}" FontSize="11" Foreground="{x:Static t:Palette.Failure}" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander IsVisible="{Binding HasGeneratedFiles}" Header="{Binding GeneratedHeader}" Padding="8,4">
                  <ItemsControl ItemsSource="{Binding GeneratedFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReviewFileItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                          <Button Classes="reviewBox" ToolTip.Tip="{Binding StateText}"
                                  Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).ToggleReviewedCommand}"
                                  CommandParameter="{Binding}">
                            <views:ReviewBox State="{Binding State}" />
                          </Button>
                          <Button Grid.Column="1" Classes="link" HorizontalAlignment="Left" Padding="6,0" Content="{Binding Path}"
                                  Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).OpenFileCommand}"
                                  CommandParameter="{Binding}" Foreground="{x:Static t:Palette.TextMuted}" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AddedText}" FontSize="11" Foreground="{x:Static t:Palette.Success}" FontFamily="Cascadia Mono, Consolas, monospace" />
                            <TextBlock Text="{Binding DeletedText}" FontSize="11" Foreground="{x:Static t:Palette.Failure}" FontFamily="Cascadia Mono, Consolas, monospace" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>

              <!-- Commits: pick one to see only its changes -->
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="{Binding CommitsHeader, Converter={x:Static views:ReviewConverters.Upper}}" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="Click a commit to see only its changes" IsVisible="{Binding HasSeveralCommits}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CommitItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewCommitItem">
                      <Button Classes="commitRow" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).ShowCommitCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Show only this commit's changes (click again for all)">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{x:Static t:Palette.TextBody}" FontFamily="Cascadia Mono, Consolas, monospace"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Author}" Classes="muted" Margin="12,0,0,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Keys: N / P next or previous file · J / K next or previous change · A approve · X reject · R approve and go to the next file · Shift+X reject and go to the next file · C comment · O overview · F5 reload" />
            </StackPanel>
          </ScrollViewer>

          <!-- The open file -->
          <DockPanel IsVisible="{Binding HasOpenFile}">
            <Border DockPanel.Dock="Top" Background="{x:Static t:Palette.Panel}" BorderBrush="{x:Static t:Palette.Border}" BorderThickness="0,0,0,1" Padding="10,5">
              <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding SelectedFile.Path}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="{x:Static t:Palette.TextPrimary}"
                             VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" MaxWidth="420" />
                  <Border Grid.Column="1" Background="{x:Static t:Palette.PurpleFill}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" IsVisible="{Binding HasFileNote}"
                          HorizontalAlignment="Left" ToolTip.Tip="{Binding FileNote}">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="3" Margin="0,0,6,0" Background="{x:Static t:Palette.Purple}"
                              IsVisible="{Binding SinceReview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Text="{Binding FileNote}" FontSize="11.5" Foreground="{x:Static t:Palette.PurpleText}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <ToggleButton Classes="small" IsChecked="{Binding IgnoreWhitespace}" Content="Ignore whitespace" ToolTip.Tip="Hide whitespace-only changes (git diff -w)" />
                  <ToggleButton Classes="small" IsChecked="{Binding WholeFileDiff}" ToolTip.Tip="Show the whole file with the changes marked">
                    <TextBlock Text="Whole file" />
                  </ToggleButton>
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="seg small" Classes.active="{Binding IsInlineDiff}" Command="{Binding SetDiffModeCommand}"
                            CommandParameter="{x:Static vm:DiffViewMode.Inline}" CornerRadius="4,0,0,4" Content="Inline" />
                    <Button Classes="seg small" Classes.active="{Binding IsSplitDiff}" Command="{Binding SetDiffModeCommand}"
                            CommandParameter="{x:Static vm:DiffViewMode.Split}" CornerRadius="0,4,4,0" Content="Side by side" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="seg small" Classes.approvedOn="{Binding SelectedFile.IsReviewed, FallbackValue=False}" Command="{Binding ApproveFileCommand}"
                            CornerRadius="4,0,0,4" ToolTip.Tip="Approve this file (A); again to clear">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource CheckIcon}" Width="11" Height="11" />
                        <TextBlock Text="Approve" />
                      </StackPanel>
                    </Button>
                    <Button Classes="seg small" Classes.rejectedOn="{Binding SelectedFile.IsRejected, FallbackValue=False}" Command="{Binding RejectFileCommand}"
                            CornerRadius="0,4,4,0" ToolTip.Tip="Reject this file (X); again to clear. Shift+X rejects it and opens the next one">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="11" Height="11" />
                        <TextBlock Text="Reject" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Button Classes="accent small" Command="{Binding MarkReviewedAndNextCommand}" ToolTip.Tip="Approve this file and open the next one (R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource CheckIcon}" Width="11" Height="11" />
                      <TextBlock Text="Approve, next" />
                    </StackPanel>
                  </Button>
                  <Button Classes="small" Command="{Binding NextFileCommand}" ToolTip.Tip="Next file (N)">
                    <PathIcon Data="{StaticResource ChevronIcon}" Width="11" Height="11" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Panel>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" IsVisible="{Binding !IsGeneratedHidden}">
                <views:DiffView x:Name="DiffView" Diff="{Binding Diff}" Mode="{Binding DiffMode}" SinceReview="{Binding SinceReview}" />
                <Panel Grid.Column="1">
                  <views:DiffScrollMarks x:Name="DiffMarks" />
                  <ScrollBar x:Name="DiffScrollBar" Classes="diffMarks" Orientation="Vertical" AllowAutoHide="False" />
                </Panel>
                <ScrollBar Grid.Row="1" x:Name="DiffHScrollBar" Orientation="Horizontal" AllowAutoHide="False" IsVisible="False" />
              </Grid>
              <StackPanel IsVisible="{Binding IsGeneratedHidden}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Generated file, hidden" FontSize="14" Foreground="{x:Static t:Palette.TextBody}" HorizontalAlignment="Center" />
                <TextBlock Text="Lock files, generated code and build output are usually not worth reading line by line." Classes="muted" HorizontalAlignment="Center" />
                <Button Classes="small" Content="Show anyway" Command="{Binding ShowGeneratedFileCommand}" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </DockPanel>
        </Panel>
      </DockPanel>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{x:Static t:Palette.Splitter}" />

      <!-- Right: conversation, checks, your pending review -->
      <TabControl Grid.Column="4" Padding="0" Background="{x:Static t:Palette.Panel}" IsVisible="{Binding IsPullRequest}">
        <TabItem Header="{Binding Pr.ConversationTabText}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,8" Spacing="10">
              <ItemsControl ItemsSource="{Binding Pr.Conversation}">
                <ItemsControl.ItemTemplate>
                  <!-- As the line comments draw theirs: avatar, then a box with a header. -->
                  <DataTemplate x:DataType="vm:ConversationItem">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                      <views:PersonAvatar DataContext="{Binding Person}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,10,0" />
                      <Border Grid.Column="1" Background="{x:Static t:Palette.Raised}" BorderBrush="{x:Static t:Palette.BorderStrong}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <StackPanel>
                          <Border Background="{x:Static t:Palette.BoxHeader}" BorderBrush="{x:Static t:Palette.BorderStrong}" BorderThickness="0,0,0,1" Padding="10,5">
                            <WrapPanel>
                              <TextBlock Text="{Binding Author}" FontSize="12.5" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <Border BorderBrush="{x:Static t:Palette.BorderBadge}" BorderThickness="1" CornerRadius="9" Padding="6,0" Margin="0,0,6,0" IsVisible="{Binding IsBot}" VerticalAlignment="Center">
                                <TextBlock Text="bot" FontSize="11" Foreground="{x:Static t:Palette.TextBadge}" />
                              </Border>
                              <TextBlock Text="{Binding Verdict}" FontSize="12" Foreground="{Binding VerdictBrush}" IsVisible="{Binding HasVerdict}" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding When}" ToolTip.Tip="{Binding WhenToolTip}" FontSize="12" Foreground="{x:Static t:Palette.TextMeta}" VerticalAlignment="Center" />
                            </WrapPanel>
                          </Border>
                          <views:MarkdownView Markdown="{Binding Body}" BaseFontSize="12.5" IsVisible="{Binding HasBody}" Margin="10,8" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="4" IsVisible="{Binding Pr.HasFileThreads}">
                <TextBlock Text="{Binding Pr.FileThreadsHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextMuted}" />
                <ItemsControl ItemsSource="{Binding Pr.FileThreads}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewThreadViewModel">
                      <StackPanel Margin="0,0,0,6">
                        <Button Classes="link" Content="{Binding Location}" HorizontalAlignment="Left" ToolTip.Tip="Open the file"
                                Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).OpenThreadCommand}"
                                CommandParameter="{Binding}" />
                        <views:ReviewThreadView DataContext="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6" Margin="0,4,0,8">
                <TextBox Text="{Binding Pr.ConversationText}" PlaceholderText="Add a comment to the conversation" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" FontSize="12" />
                <Button Classes="accent small" Content="Comment" Command="{Binding Pr.SendConversationCommentCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Pr.ChecksTabText}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,8" Spacing="2">
              <TextBlock Text="No checks on this pull request." Classes="muted" IsVisible="{Binding !Pr.HasChecks}" />
              <ItemsControl ItemsSource="{Binding Pr.Checks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                      <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,8,0" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{x:Static t:Palette.TextPrimary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="required" Classes="muted" IsVisible="{Binding IsRequired}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <Button Classes="link" Content="Details" IsVisible="{Binding HasDetailsUrl}" Margin="6,0,0,0"
                                Command="{Binding $parent[views:PullRequestReviewView].((vm:PullRequestReviewViewModel)DataContext).OpenUrlCommand}"
                                CommandParameter="{Binding DetailsUrl}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Your review">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,10" Spacing="10">
              <TextBlock Text="{Binding ProgressText}" FontSize="12.5" Foreground="{x:Static t:Palette.TextPrimary}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Pr.HasPending}"
                         Text="No line comments yet. Hover a line in a file and click + to add one, then choose Add to review." />
              <ItemsControl ItemsSource="{Binding Pr.Pending}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingCommentViewModel">
                    <Border Background="{x:Static t:Palette.SubtleFill}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{Binding Location}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{x:Static t:Palette.BranchText}" />
                        <Button Grid.Column="1" Classes="link" Content="Remove" Command="{Binding RemoveCommand}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Body}" FontSize="12" Foreground="{x:Static t:Palette.TextBody}" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="accent" Command="{Binding SubmitReviewCommand}" IsVisible="{Binding Pr.CanReview}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding ReviewButtonText}" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
