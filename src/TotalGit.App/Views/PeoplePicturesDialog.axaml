<Window xmlns="https://github.com/avaloniaui"
        xmlns:t="using:TotalGit.App.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TotalGit.App.ViewModels"
        x:Class="TotalGit.App.Views.PeoplePicturesDialog"
        x:DataType="vm:PeoplePicturesViewModel"
        Title="People's pictures"
        Width="560" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static t:Palette.Dialog}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Text="People's pictures" FontSize="18" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
      <TextBlock Foreground="{x:Static t:Palette.TextSecondary}" TextWrapping="Wrap"
                 Text="Pictures you've chosen for people, shown instead of their GitHub or Gravatar picture. To add one, right-click someone's commit or avatar and choose Set picture." />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <Button Grid.Column="1" Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" />
    </Grid>
    <Border Background="{x:Static t:Palette.Well}" CornerRadius="4">
      <Panel>
        <TextBlock Text="No pictures chosen yet." Foreground="{x:Static t:Palette.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding People}" Margin="6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PeoplePictureRow">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                  <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                    <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
                    <TextBlock Text="{Binding UsedFor}" FontSize="11" Foreground="{x:Static t:Palette.TextMuted}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Change…" Padding="10,3" FontSize="12" MinHeight="0" Click="OnChange" />
                    <Button Content="Remove" Padding="10,3" FontSize="12" MinHeight="0"
                            Command="{Binding $parent[Window].((vm:PeoplePicturesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </DockPanel>
</Window>
