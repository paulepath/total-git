<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             x:Class="TotalGit.App.Views.WorktreeChangesView"
             x:DataType="vm:WorktreeChangesViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Padding="14,12" BorderBrush="#30353C" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource WorktreeIcon}" Width="14" Height="14" Foreground="#8A9099" />
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#E6E8EB" />
        </StackPanel>
        <TextBlock Text="{Binding BranchText}" FontSize="12" Foreground="#A9AFB8" />
        <SelectableTextBlock Text="{Binding Path}" FontSize="11" Foreground="#6B727C" TextWrapping="Wrap" />
        <TextBlock FontSize="12" Foreground="#A9AFB8" TextWrapping="Wrap"
                   Text="Uncommitted changes in another worktree. Open it in a tab to stage and commit them." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenTabButton" Content="Open worktree in tab" Classes="accent" />
          <Button x:Name="OpenCodeButton" Content="Open in VS Code" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" Text="{Binding FileCountText}" Margin="14,10,14,6" FontSize="11" FontWeight="SemiBold" Foreground="#8A9099" />

    <ListBox Grid.Row="2" x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="14,3" />
          <Setter Property="MinHeight" Value="24" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FileChangeItem">
          <Grid ColumnDefinitions="18,Auto,*,Auto" ToolTip.Tip="{Binding ToolTip}">
            <TextBlock Text="{Binding StatusLetter}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="#E6E8EB" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Folder}" FontSize="11" Foreground="#6B727C" IsVisible="{Binding HasFolder}"
                       TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="staged" FontSize="11" Foreground="#4CC38A" IsVisible="{Binding IsStaged}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
