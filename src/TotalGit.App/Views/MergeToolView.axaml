<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:git="using:TotalGit.Core.Git"
             x:Class="TotalGit.App.Views.MergeToolView"
             x:DataType="vm:MergeToolViewModel"
             Background="#1C1F24">
  <UserControl.Styles>
    <Style Selector="ListBox.pane">
      <Setter Property="Background" Value="#1C1F24" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.pane ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.pane ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.pane ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.ours Border.conflict">
      <Setter Property="Background" Value="#1B2C40" />
    </Style>
    <Style Selector="ListBox.ours Border.current">
      <Setter Property="Background" Value="#24497A" />
    </Style>
    <Style Selector="ListBox.theirs Border.conflict">
      <Setter Property="Background" Value="#1B3329" />
    </Style>
    <Style Selector="ListBox.theirs Border.current">
      <Setter Property="Background" Value="#1F6146" />
    </Style>
    <Style Selector="TextBlock.paneTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: file, navigation, whole-file choices, save -->
    <Border DockPanel.Dock="Top" Background="#23272D" Padding="12,6" BorderBrush="#30353C" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource MergeIcon}" Width="14" Height="14" Foreground="#F5C26B" />
          <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="#E6E8EB"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0" VerticalAlignment="Center" IsVisible="{Binding HasConflicts}">
          <Button Classes="small" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous conflict">‹</Button>
          <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="#A9AFB8" VerticalAlignment="Center" />
          <Button Classes="small" Command="{Binding NextCommand}" ToolTip.Tip="Next conflict">›</Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="small" Content="Whole file ▾" ToolTip.Tip="Resolve the whole file with one side's version">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{Binding OursLabel, StringFormat='Use {0} for the whole file'}"
                          Command="{Binding TakeWholeFileCommand}" CommandParameter="{x:True}" />
                <MenuItem Header="{Binding TheirsLabel, StringFormat='Use {0} for the whole file'}"
                          Command="{Binding TakeWholeFileCommand}" CommandParameter="{x:False}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="small accent" Command="{Binding SaveCommand}" IsVisible="{Binding IsText}"
                  ToolTip.Tip="Write the result and mark the file resolved">Save and mark resolved</Button>
          <Button Command="{Binding CloseCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Close (Esc)">
            <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Binary files can only take one side. -->
    <TextBlock IsVisible="{Binding IsBinary}" Text="This is a binary file. Use the Whole file menu above to choose which side's version to keep."
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A9099" />

    <Grid IsVisible="{Binding IsText}" RowDefinitions="Auto,*,4,Auto,*">
      <!-- Choices for the current conflict -->
      <Border Grid.Row="0" Background="#1F2328" Padding="12,6" BorderBrush="#30353C" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding CurrentChoiceText}" FontSize="12" Foreground="#A9AFB8" VerticalAlignment="Center" MinWidth="150" />
          <Button Classes="small" Command="{Binding ChooseCommand}" CommandParameter="{x:Static git:ConflictChoice.OursThenTheirs}"
                  IsEnabled="{Binding HasConflicts}" ToolTip.Tip="{Binding OursLabel, StringFormat='Keep both sides, {0} first'}">Take both (left first)</Button>
          <Button Classes="small" Command="{Binding ChooseCommand}" CommandParameter="{x:Static git:ConflictChoice.TheirsThenOurs}"
                  IsEnabled="{Binding HasConflicts}" ToolTip.Tip="{Binding TheirsLabel, StringFormat='Keep both sides, {0} first'}">Take both (right first)</Button>
        </StackPanel>
      </Border>

      <!-- Ours | Theirs -->
      <Grid Grid.Row="1" ColumnDefinitions="*,4,*">
        <DockPanel Grid.Column="0">
          <Border DockPanel.Dock="Top" Background="#1B2C40" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="paneTitle" Foreground="#8CC4FF" Text="{Binding OursLabel}" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="small" Command="{Binding ChooseCommand}" CommandParameter="{x:Static git:ConflictChoice.Ours}"
                      IsEnabled="{Binding HasConflicts}" ToolTip.Tip="Use this side for the current conflict">Take this side</Button>
            </Grid>
          </Border>
          <ListBox x:Name="OursPane" Classes="pane ours" ItemsSource="{Binding OursLines}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MergeLine">
                <Border Classes.conflict="{Binding IsConflict}" Classes.current="{Binding IsCurrent}">
                  <Grid ColumnDefinitions="44,*">
                    <TextBlock Text="{Binding Number}" Foreground="#5C636D" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#D5D9DE" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Background="#2B2F36" />
        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Background="#1B3329" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="paneTitle" Foreground="#7FE0B2" Text="{Binding TheirsLabel}" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="small" Command="{Binding ChooseCommand}" CommandParameter="{x:Static git:ConflictChoice.Theirs}"
                      IsEnabled="{Binding HasConflicts}" ToolTip.Tip="Use this side for the current conflict">Take this side</Button>
            </Grid>
          </Border>
          <ListBox x:Name="TheirsPane" Classes="pane theirs" ItemsSource="{Binding TheirsLines}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MergeLine">
                <Border Classes.conflict="{Binding IsConflict}" Classes.current="{Binding IsCurrent}">
                  <Grid ColumnDefinitions="44,*">
                    <TextBlock Text="{Binding Number}" Foreground="#5C636D" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#D5D9DE" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

      <!-- Result -->
      <Border Grid.Row="3" Background="#23272D" Padding="10,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="paneTitle" Foreground="#E6E8EB" Text="Result" />
          <TextBlock Grid.Column="1" Text="{Binding UnresolvedText}" FontSize="11" Foreground="#8A9099" Margin="10,0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="small" Command="{Binding ResetResultCommand}" IsVisible="{Binding IsManual}"
                  ToolTip.Tip="Throw away your edits and rebuild the result from the choices">Rebuild from choices</Button>
        </Grid>
      </Border>
      <TextBox Grid.Row="4" Text="{Binding Result}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Background="#16191D" BorderThickness="0"
               CornerRadius="0" VerticalContentAlignment="Top"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </DockPanel>
</UserControl>
