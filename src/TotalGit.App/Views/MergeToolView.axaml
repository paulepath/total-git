<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:views="using:TotalGit.App.Views"
             xmlns:git="using:TotalGit.Core.Git"
             x:Class="TotalGit.App.Views.MergeToolView"
             x:DataType="vm:MergeToolViewModel"
             Background="#1C1F24">
  <UserControl.Styles>
    <Style Selector="TextBlock.paneTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7A818B" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.pick">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ToggleButton.pick TextBlock.key">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="ToggleButton.base:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8A6420" />
    </Style>
    <Style Selector="ToggleButton.ours:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#24497A" />
    </Style>
    <Style Selector="ToggleButton.theirs:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F6146" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: file, navigation, whole-file choices, save -->
    <Border DockPanel.Dock="Top" Background="#23272D" Padding="12,6" BorderBrush="#30353C" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource MergeIcon}" Width="14" Height="14" Foreground="#F5C26B" />
          <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="#E6E8EB"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0" VerticalAlignment="Center" IsVisible="{Binding HasConflicts}">
          <Button Classes="small" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous conflict (Ctrl+Up)">‹</Button>
          <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="#A9AFB8" VerticalAlignment="Center" />
          <Button Classes="small" Command="{Binding NextCommand}" ToolTip.Tip="Next conflict (Ctrl+Down)">›</Button>
          <Button Classes="small" Command="{Binding NextUnresolvedCommand}" ToolTip.Tip="Next unresolved conflict (Ctrl+Shift+Down)">Next unresolved</Button>
          <TextBlock Text="{Binding UnresolvedText}" FontSize="11" Foreground="#8A9099" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="small" Content="Whole file ▾" ToolTip.Tip="Resolve the whole file with one side's version">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{Binding OursLabel, StringFormat='Use {0} for the whole file'}"
                          Command="{Binding TakeWholeFileCommand}" CommandParameter="{x:True}" />
                <MenuItem Header="{Binding TheirsLabel, StringFormat='Use {0} for the whole file'}"
                          Command="{Binding TakeWholeFileCommand}" CommandParameter="{x:False}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="small accent" Command="{Binding SaveCommand}" IsVisible="{Binding IsText}"
                  ToolTip.Tip="Write the result and mark the file resolved">Save and mark resolved</Button>
          <Button Command="{Binding CloseCommand}" Background="Transparent" Padding="6" ToolTip.Tip="Close (Esc)">
            <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Binary files can only take one side. -->
    <TextBlock IsVisible="{Binding IsBinary}" Text="This is a binary file. Use the Whole file menu above to choose which side's version to keep."
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A9099" />

    <Grid IsVisible="{Binding IsText}" RowDefinitions="Auto,*,4,Auto,*,Auto" ColumnDefinitions="*,Auto">
      <!-- What goes into the result for the current conflict -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1F2328" Padding="12,5" BorderBrush="#30353C" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding HasConflicts}" IsVisible="{Binding IsPaneMode}">
            <ToggleButton Classes="small pick base" IsVisible="{Binding HasBase}" IsChecked="{Binding IsBasePicked, Mode=OneWay}"
                          Command="{Binding ToggleSideCommand}" CommandParameter="{x:Static git:MergeSide.Base}"
                          ToolTip.Tip="Add the base version to the result, after what's picked (Ctrl+1)">
              <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="A" /><TextBlock Text="Base" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="small pick ours" IsChecked="{Binding IsOursPicked, Mode=OneWay}"
                          Command="{Binding ToggleSideCommand}" CommandParameter="{x:Static git:MergeSide.Ours}"
                          ToolTip.Tip="Add this side to the result, after what's picked (Ctrl+2)">
              <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="B" /><TextBlock Text="{Binding OursLabel}" MaxWidth="220" TextTrimming="CharacterEllipsis" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="small pick theirs" IsChecked="{Binding IsTheirsPicked, Mode=OneWay}"
                          Command="{Binding ToggleSideCommand}" CommandParameter="{x:Static git:MergeSide.Theirs}"
                          ToolTip.Tip="Add this side to the result, after what's picked (Ctrl+3)">
              <StackPanel Orientation="Horizontal"><TextBlock Classes="key" Text="C" /><TextBlock Text="{Binding TheirsLabel}" MaxWidth="220" TextTrimming="CharacterEllipsis" /></StackPanel>
            </ToggleButton>
            <Border Width="1" Background="#3A3F47" Margin="4,2" />
            <Button Classes="small" Command="{Binding SwapOrderCommand}" ToolTip.Tip="Put the picked sides the other way round">Swap order</Button>
            <Button Classes="small" Command="{Binding UseNothingCommand}" ToolTip.Tip="Leave this conflict's lines out of the result">Use nothing</Button>
            <Button Classes="small" Command="{Binding ClearChoiceCommand}" ToolTip.Tip="Unresolve this conflict">Clear</Button>
            <TextBlock Text="{Binding CurrentChoiceText}" FontSize="12" Foreground="#A9AFB8" VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <CheckBox Content="Show base" FontSize="12" IsChecked="{Binding ShowBase}" IsVisible="{Binding HasBase}"
                      ToolTip.Tip="Show the common ancestor next to the two sides" />
            <ToggleButton Classes="small" IsChecked="{Binding IsTextMode, Mode=OneWay}" Command="{Binding ToggleTextModeCommand}"
                          ToolTip.Tip="Edit the whole result as plain text (not lined up with the panes)">Edit result as text</ToggleButton>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Base | Ours | Theirs, scrolled sideways together -->
      <DockPanel Grid.Row="1">
      <ScrollBar DockPanel.Dock="Bottom" x:Name="SourceHScroll" Orientation="Horizontal" IsVisible="False" AllowAutoHide="False" />
      <Grid x:Name="SourcePanes" ColumnDefinitions="*,4,*,4,*">
        <DockPanel Grid.Column="0" x:Name="BaseColumn">
          <Border DockPanel.Dock="Top" Background="#3A2E17" Padding="10,4" Height="26">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="paneTitle" Foreground="#F0C27A" Text="A  Base" />
              <TextBlock Classes="hint" Text="common ancestor" />
            </StackPanel>
          </Border>
          <views:MergePaneView x:Name="BasePane" Pane="Base" />
        </DockPanel>
        <GridSplitter Grid.Column="1" x:Name="BaseSplitter" ResizeDirection="Columns" Background="#2B2F36" />
        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Background="#1B2C40" Padding="10,4" Height="26">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="paneTitle" Foreground="#8CC4FF" Text="{Binding OursLabel, StringFormat='B  {0}'}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="hint" Text="click a line to pick it · click the margin for the whole side" />
            </StackPanel>
          </Border>
          <views:MergePaneView x:Name="OursPane" Pane="Ours" />
        </DockPanel>
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#2B2F36" />
        <DockPanel Grid.Column="4">
          <Border DockPanel.Dock="Top" Background="#1B3329" Padding="10,4" Height="26">
            <TextBlock Classes="paneTitle" Foreground="#7FE0B2" Text="{Binding TheirsLabel, StringFormat='C  {0}'}" TextTrimming="CharacterEllipsis" />
          </Border>
          <views:MergePaneView x:Name="TheirsPane" Pane="Theirs" />
        </DockPanel>
      </Grid>
      </DockPanel>

      <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="#2B2F36" />

      <!-- Result -->
      <Border Grid.Row="3" Background="#23272D" Padding="10,4" Height="26">
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="paneTitle" Foreground="#E6E8EB" Text="Result" />
          <TextBlock Classes="hint" Text="double-click a block to type over it" IsVisible="{Binding IsPaneMode}" />
        </StackPanel>
      </Border>
      <Panel Grid.Row="4" x:Name="ResultHost">
        <views:MergePaneView x:Name="ResultPane" Pane="Result" IsVisible="{Binding IsPaneMode}" />
        <Canvas x:Name="EditLayer" IsVisible="{Binding IsPaneMode}" />
        <TextBox Text="{Binding Result}" IsVisible="{Binding IsTextMode}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Background="#16191D" BorderThickness="0"
                 CornerRadius="0" VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Panel>

      <!-- One scroll bar and a map of the file for every pane -->
      <DockPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" IsVisible="{Binding IsPaneMode}">
        <views:MergeOverview x:Name="Overview" DockPanel.Dock="Right" Width="14" Margin="0,26,0,0"
                             ToolTip.Tip="Conflicts in the file (red: unresolved). Click to go there." />
        <ScrollBar x:Name="VScroll" Orientation="Vertical" Margin="0,26,0,0" AllowAutoHide="False" />
      </DockPanel>
      <!-- The result scrolls sideways on its own -->
      <ScrollBar Grid.Row="5" x:Name="ResultHScroll" Orientation="Horizontal" IsVisible="False" AllowAutoHide="False" />
    </Grid>
  </DockPanel>
</UserControl>
