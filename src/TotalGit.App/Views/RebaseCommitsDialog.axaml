<Window xmlns="https://github.com/avaloniaui"
        xmlns:t="using:TotalGit.App.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TotalGit.App.ViewModels"
        x:Class="TotalGit.App.Views.RebaseCommitsDialog"
        x:DataType="vm:RebaseCommitsViewModel"
        Title="Rebase selected commits"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static t:Palette.Dialog}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />

    <!-- The commits that will be replayed, newest first, as in the graph. -->
    <Border Background="{x:Static t:Palette.Well}" CornerRadius="4" Padding="10,6" BorderBrush="{x:Static t:Palette.AccentStrong}" BorderThickness="3,0,0,0">
      <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Commits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RangeCommitItem">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <TextBlock Text="{Binding ShortSha}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="{x:Static t:Palette.Accent}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="12" Foreground="{x:Static t:Palette.TextPrimary}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Spacing="4">
      <TextBlock Text="Onto" FontSize="12" Foreground="{x:Static t:Palette.TextMuted}" />
      <AutoCompleteBox x:Name="TargetBox" Text="{Binding Target}" ItemsSource="{Binding Targets}" FilterMode="Contains"
                       MinimumPrefixLength="0" MaxDropDownHeight="260" PlaceholderText="main" />
      <TextBlock Text="{Binding TargetDescription}" FontSize="11" Foreground="{x:Static t:Palette.TextDim}" TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding TargetDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Put the result in" FontSize="12" Foreground="{x:Static t:Palette.TextMuted}" />
      <TextBlock Text="{Binding NotATipNote}" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" TextWrapping="Wrap"
                 IsVisible="{Binding NotATipNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Spacing="6" IsVisible="{Binding CanMoveExisting}">
        <RadioButton GroupName="result" IsChecked="{Binding MoveExisting}" Content="{Binding MoveExistingText}" />
        <ComboBox ItemsSource="{Binding TipBranches}" SelectedItem="{Binding BranchToMove}" Margin="28,0,0,0" MinWidth="260"
                  IsVisible="{Binding HasSeveralTipBranches}" IsEnabled="{Binding MoveExisting}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BranchChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <RadioButton GroupName="result" IsChecked="{Binding MoveNew}" Content="Create a new branch (leave the original as it is)" />
      </StackPanel>
      <TextBox Text="{Binding NewBranchName}" IsVisible="{Binding MoveNew}" Margin="28,0,0,0" PlaceholderText="new-branch-name" />
    </StackPanel>

    <Border Background="{x:Static t:Palette.Well}" CornerRadius="4" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{x:Static t:Palette.TextStrong}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontSize="12" Foreground="{x:Static t:Palette.Pending}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Error}" Foreground="{x:Static t:Palette.Error}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="Rebase" IsDefault="True" Classes="accent" IsEnabled="{Binding IsValid}" Click="OnRebase" />
    </StackPanel>
  </StackPanel>
</Window>
