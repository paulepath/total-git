<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TotalGit.App.ViewModels"
        x:Class="TotalGit.App.Views.TabStyleDialog"
        x:DataType="vm:TabStyleViewModel"
        Title="{Binding Title}"
        Width="560" Height="600" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#23272D">
  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="#E6E8EB" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.icons ListBoxItem">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="Tab colour and icon" FontSize="18" FontWeight="SemiBold" Foreground="#E6E8EB" />
      <TextBlock Foreground="#A9AFB8" TextWrapping="Wrap"
                 Text="Remembered for this repository, including its worktrees, and kept when its tab is closed." />

      <!-- Live preview of the tab -->
      <TextBlock Classes="field" Text="Preview" />
      <StackPanel Orientation="Horizontal" Spacing="2" Background="#16191D" HorizontalAlignment="Left">
        <Border CornerRadius="6,6,0,0" Background="#1F2328" ClipToBounds="True">
          <Panel>
            <Border Background="{Binding PreviewTint}" />
            <Border Height="3" VerticalAlignment="Top" Background="{Binding PreviewAccent}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,16,0" Height="34">
              <Image Source="{Binding PreviewIcon}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding HasPreviewIcon}" />
              <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" Foreground="#8A9099" VerticalAlignment="Center"
                        IsVisible="{Binding HasNoPreviewIcon}" />
              <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E6E8EB" VerticalAlignment="Center" />
            </StackPanel>
          </Panel>
        </Border>
      </StackPanel>

      <TextBlock Classes="field" Text="Colour" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ItemsControl ItemsSource="{Binding Colours}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColourChoice">
              <Button Classes="swatch" ToolTip.Tip="{Binding ToolTip}"
                      Command="{Binding $parent[Window].((vm:TabStyleViewModel)DataContext).PickColourCommand}" CommandParameter="{Binding}">
                <Ellipse Width="20" Height="20" Fill="{Binding Brush}" Stroke="#4A505A" StrokeThickness="1" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Text="{Binding ColourText}" Width="90" PlaceholderText="#RRGGBB" FontFamily="Cascadia Mono, Consolas, monospace" />
      </StackPanel>

      <TextBlock Classes="field" Text="Icon" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox Text="{Binding IconFilter}" PlaceholderText="Search icons" />
        <Button Grid.Column="1" Classes="small" Content="Upload…" Margin="6,0,0,0" Click="OnUpload"
                ToolTip.Tip="Use your own picture (PNG, JPG, BMP or ICO, up to 1 MB)" />
        <Button Grid.Column="2" Classes="small" Content="Folder icon" Margin="6,0,0,0" Command="{Binding ClearIconCommand}"
                ToolTip.Tip="No icon of its own: the plain folder icon" />
      </Grid>
      <TextBlock Foreground="#E5484D" FontSize="11" Margin="0,4,0,0" Text="{Binding UploadError}"
                 IsVisible="{Binding UploadError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
      <Button Classes="small" Content="Reset" Command="{Binding ResetCommand}" ToolTip.Tip="No colour, folder icon" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
        <Button Content="Save" IsDefault="True" Classes="accent" Click="OnSave" />
      </StackPanel>
    </Grid>

    <Border Background="#1C1F24" CornerRadius="4" Margin="0,6,0,0">
      <ListBox Classes="icons" Background="Transparent" ItemsSource="{Binding Icons}" SelectedItem="{Binding SelectedIcon}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IconChoice">
            <Image Source="{Binding Preview}" Width="22" Height="22" ToolTip.Tip="{Binding ToolTip}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
