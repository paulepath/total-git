<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TotalGit.App.ViewModels"
             xmlns:views="using:TotalGit.App.Views"
             x:Class="TotalGit.App.Views.PullRequestView"
             x:DataType="vm:PullRequestViewModel">
  <UserControl.Styles>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A9099" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#5AA9F2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="14,12" BorderBrush="#30353C" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="2" Command="{Binding RefreshCommand}" Padding="6,4" MinHeight="0" Background="Transparent"
                  VerticalAlignment="Top" ToolTip.Tip="Reload the pull request">
            <PathIcon Data="{StaticResource RefreshIcon}" Width="12" Height="12" Foreground="#A9AFB8" />
          </Button>
          <PathIcon Data="{StaticResource PullRequestIcon}" Width="14" Height="14" Foreground="#8A9099" VerticalAlignment="Top" Margin="0,3,8,0" />
          <SelectableTextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="#E6E8EB">
            <Run Text="{Binding Title}" />
            <Run Text="{Binding NumberText}" Foreground="#8A9099" FontWeight="Normal" />
          </SelectableTextBlock>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Background="#3A4250" CornerRadius="9" Padding="7,1" IsVisible="{Binding IsDraft}">
            <TextBlock Text="Draft" FontSize="11" Foreground="#C2C7CE" />
          </Border>
          <TextBlock Text="{Binding StatsText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasDetails}" />
        </StackPanel>
        <TextBlock Text="{Binding AuthorText}" FontSize="12" Foreground="#A9AFB8" TextWrapping="Wrap" />

        <!-- Whether it can be merged, and what's blocking it. -->
        <Border BorderBrush="{Binding MergeBrush}" BorderThickness="3,0,0,0" Background="#262A31" Padding="8,5" CornerRadius="2"
                IsVisible="{Binding MergeText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding MergeText}" FontSize="12" Foreground="#D5D8DD" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding Reviewers}" IsVisible="{Binding HasReviewers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewerItem">
              <Border Background="#262A31" CornerRadius="9" Padding="8,2" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#D5D8DD" />
                  <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StateBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Error}" Foreground="#F26B6B" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasError}" />

        <WrapPanel Orientation="Horizontal">
          <Button Classes="accent" Command="{Binding CheckoutCommand}" Margin="0,0,8,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource WorktreeIcon}" Width="12" Height="12" />
              <TextBlock Text="Check out in worktree" />
            </StackPanel>
          </Button>
          <Button Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,4" ToolTip.Tip="Open on the web">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource BrowserIcon}" Width="12" Height="12" />
              <TextBlock Text="Open on web" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ReviewCommand}" Margin="0,0,8,4" IsVisible="{Binding CanReview}"
                  ToolTip.Tip="Submit a review: comment, approve or request changes, with your pending line comments">
            <TextBlock Text="{Binding ReviewButtonText}" />
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" x:Name="Tabs">
      <TabItem Header="{Binding FilesTabText}">
        <Panel>
          <views:FileTreeView x:Name="Files" DataContext="{Binding FileTree}" IsVisible="{Binding $parent[UserControl].((vm:PullRequestViewModel)DataContext).HasFiles}" />
          <TextBlock Text="Fetching the pull request…" Classes="muted" Margin="14,10" IsVisible="{Binding IsLoadingFiles}" />
        </Panel>
      </TabItem>

      <TabItem Header="{Binding ChecksTabText}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,8" Spacing="2">
            <TextBlock Text="No checks on this pull request." Classes="muted" IsVisible="{Binding !HasChecks}" />
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,8,0" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E6E8EB" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="required" Classes="muted" IsVisible="{Binding IsRequired}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                      <Button Classes="link" Content="Details" IsVisible="{Binding HasDetailsUrl}" Margin="6,0,0,0"
                              Command="{Binding $parent[views:PullRequestView].OpenUrlCommand}" CommandParameter="{Binding DetailsUrl}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding ConversationTabText}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,8" Spacing="10">
            <Border Background="#262A31" CornerRadius="4" Padding="10,8" IsVisible="{Binding HasBody}">
              <SelectableTextBlock Text="{Binding Body}" FontSize="12" Foreground="#C2C7CE" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="No description." Classes="muted" IsVisible="{Binding !HasBody}" />
            <ItemsControl ItemsSource="{Binding Conversation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItem">
                  <StackPanel Spacing="3" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold" Foreground="#E6E8EB" />
                      <TextBlock Text="{Binding Verdict}" FontSize="11" Foreground="{Binding VerdictBrush}" IsVisible="{Binding HasVerdict}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding When}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Body}" FontSize="12" Foreground="#C2C7CE" TextWrapping="Wrap" IsVisible="{Binding HasBody}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Line comments, including outdated ones that no longer show in the diff. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasFileThreads}">
              <TextBlock Text="{Binding FileThreadsHeader}" FontSize="11" FontWeight="SemiBold" Foreground="#8A9099" />
              <ItemsControl ItemsSource="{Binding FileThreads}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReviewThreadViewModel">
                    <StackPanel Margin="0,0,0,6">
                      <Button Classes="link" Content="{Binding Location}" HorizontalAlignment="Left" ToolTip.Tip="Open the file"
                              Command="{Binding $parent[views:PullRequestView].((vm:PullRequestViewModel)DataContext).OpenThreadCommand}"
                              CommandParameter="{Binding}" />
                      <views:ReviewThreadView DataContext="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" Margin="0,4,0,8">
              <TextBox Text="{Binding ConversationText}" PlaceholderText="Add a comment to the conversation" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="60" FontSize="12" />
              <Button Classes="accent" Content="Comment" Command="{Binding SendConversationCommentCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
