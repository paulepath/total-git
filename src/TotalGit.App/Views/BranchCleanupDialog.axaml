<Window xmlns="https://github.com/avaloniaui"
        xmlns:t="using:TotalGit.App.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TotalGit.App.ViewModels"
        x:Class="TotalGit.App.Views.BranchCleanupDialog"
        x:DataType="vm:BranchCleanupViewModel"
        Title="Clean up branches"
        Width="760" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static t:Palette.Dialog}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Clean up branches" FontSize="18" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" />
      <TextBlock Foreground="{x:Static t:Palette.TextSecondary}" TextWrapping="Wrap"
                 Text="These local branches tracked a remote branch that has since been deleted (usually after a PR was merged). Deleting is a force delete: commits that are only on these branches are lost." />
      <Border Background="{x:Static t:Palette.WarningFill}" CornerRadius="4" Padding="10,6" IsVisible="{Binding FetchFailed}" HorizontalAlignment="Left">
        <TextBlock Foreground="{x:Static t:Palette.WarningText}" TextWrapping="Wrap" Text="Couldn't reach the remote, so this list is from the last fetch." />
      </Border>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="{Binding DeleteText}" IsDefault="True" Classes="accent" IsEnabled="{Binding CanDelete}" Click="OnDelete" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="10,0,0,4">
      <CheckBox IsChecked="{Binding AllChecked}" Content="Select all" Foreground="{x:Static t:Palette.TextPrimary}" />
      <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Foreground="{x:Static t:Palette.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <Border Background="{x:Static t:Palette.Well}" CornerRadius="4">
      <ListBox ItemsSource="{Binding Items}" Background="Transparent" SelectionMode="Single">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BranchCleanupItem">
            <Grid ColumnDefinitions="Auto,*,Auto" Opacity="{Binding IsSelectable, Converter={x:Static vm:Converters.DimWhenFalse}}">
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" Margin="0,-4,4,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <!-- One wrapping block, so a long name or upstream wraps instead of running under the date. -->
                <DockPanel>
                  <Image DockPanel.Dock="Left" Source="{Binding KindIcon}" IsVisible="{Binding HasKindIcon}" Width="14" Height="14"
                         VerticalAlignment="Top" Margin="0,3,6,0" />
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Name}" FontWeight="SemiBold" Foreground="{x:Static t:Palette.TextPrimary}" /><Run Text="  " /><Run Text="{Binding Upstream}" FontSize="12" Foreground="{x:Static t:Palette.TextMuted}" />
                  </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding Subject}" FontSize="12" Foreground="{x:Static t:Palette.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding UnpushedText}" IsVisible="{Binding HasUnpushed}" FontSize="12" Foreground="{x:Static t:Palette.Warning}" />
                <TextBlock Text="{Binding Reason}" IsVisible="{Binding HasReason}" FontSize="12" Foreground="{x:Static t:Palette.Warning}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Foreground="{x:Static t:Palette.TextMuted}" VerticalAlignment="Top" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
