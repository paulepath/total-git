    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Every window, dialogs included, uses the app icon in its title bar and the taskbar. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/totalgit.ico" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Disabled toolbar buttons (e.g. in an empty tab) stay flat, just dimmed. -->
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.count">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.Accent}" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="{x:Static t:Palette.SegmentFill}" />
      <Setter Property="Foreground" Value="{x:Static t:Palette.TextSecondary}" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Background" Value="{x:Static t:Palette.SegmentActive}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static t:Palette.SegmentActiveHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{x:Static t:Palette.Splitter}" />
    </Style>
    <!-- Scroll bars keep a column of their own instead of floating over the content: an auto-hiding one widens
         on hover and covers the buttons and counts at the right of each row, which then can't be clicked. -->
    <Style Selector="TreeView, ListBox">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <!-- A diff's scroll bar: its track see-through, so the change marks drawn under it show (DiffScrollMarks paints the track) -->
    <Style Selector="ScrollBar.diffMarks /template/ Rectangle#TrackRect">
      <Setter Property="Fill" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
